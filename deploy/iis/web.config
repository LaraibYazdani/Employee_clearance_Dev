<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverse-proxy web.config for the Employee Clearance Portal (Dev/Testing server).

  This file does NOT go inside the app's repo folder that IIS serves from.
  It belongs in the physical path of the IIS SITE itself (a separate, mostly-empty
  folder, e.g. C:\inetpub\clearance-dev\), which just proxies every request to the
  PM2-managed Next.js process listening on 127.0.0.1:8000.

  Prerequisites on the IIS box (per your confirmation these are installed):
    - URL Rewrite module
    - Application Request Routing (ARR) — and ARR's "Enable proxy" must be turned on:
      IIS Manager -> (server node, top level) -> Application Request Routing Cache
      -> Server Proxy Settings... -> check "Enable proxy" -> Apply.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNextJs" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Optional: raise if you expect large file uploads (attachments) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50 MB -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
