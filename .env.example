# Copy this file to .env.local on the server and fill in real values.
# Never commit the filled-in file — .env.local is already gitignored.

# --- Database (point this at the copied dev/test database) ---
DATABASE_URL="mysql://user:password@localhost:3306/employee_clearance_dev"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# --- Outbound email (SMTP) ---
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Display name/address for outgoing mail — make this obviously non-production
SMTP_FROM="Employee Clearance Portal (TEST) <clearance-portal-test@company.com>"

# --- Public app URL used to build links inside emails ---
# Must match the hostname this dev server is reachable at (used in CTA button links)
NEXT_PUBLIC_APP_URL="http://dev.company.com"

# --- SAP SuccessFactors integration ---
SF_MOCK_MODE="true"
SF_BASE_URL="https://api44.sapsf.com"
SF_COMPANY_ID="packagesli"
SF_CLIENT_ID=""
SF_PRIVATE_KEY=""
SF_ECADMIN_USER_ID=""
SF_API_USER=""
SF_API_PASS=""
